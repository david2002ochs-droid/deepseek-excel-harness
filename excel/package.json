{
  "name": "dsh-excel-taskpane-local",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "certs": "npx --yes office-addin-dev-certs@3.0.1 install",
    "start": "node start.mjs",
    "test": "node --test launch.test.mjs context.test.mjs sideload.test.mjs",
    "sideload": "node sideload.mjs",
    "stop": "npx --yes office-addin-debugging@7.0.1 stop manifest.xml",
    "validate": "npx --yes office-addin-manifest@3.0.1 validate manifest.xml"
  },
  "dependencies": {
    "http-proxy": "1.18.1",
    "office-addin-dev-settings": "4.0.1",
    "office-addin-manifest": "3.0.1",
    "open": "8.4.2"
  }
}
